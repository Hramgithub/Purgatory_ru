{"chunk":60,"items":[{"id":13369,"translation":"«Входи», — рявкнул изнутри хриплый голос."},{"id":13370,"translation":"«У нас для тебя сообщение»."},{"id":13371,"translation":"«Речь об операции на болотах»."},{"id":13372,"translation":"«Речь об операции завтра вечером»."},{"id":13373,"translation":"«Нам забрать это?»"},{"id":13374,"translation":"«Как бы там ни было, нам пора уходить, пока нас здесь не застукали»."},{"id":13375,"translation":"«Надо спешить, пока она не ушла», — сказала ⟦T000⟧."},{"id":13376,"translation":"«Да?»"},{"id":13377,"translation":"«Я слышала, вы работаете с корпорацией VX."},{"id":13378,"translation":"« «Пойдём за ней?»"},{"id":13379,"translation":"« Я не знала, что и думать."},{"id":13380,"translation":"« «Что ты о ней думаешь?»"},{"id":13381,"translation":"«Ради тебя же надеюсь, что так». За ней хлопнула дверь."},{"id":13382,"translation":"«Интересно только, откуда они об этом узнали», — задумчиво произнесла она."},{"id":13383,"translation":"«⟦T000⟧!» — крикнула я."},{"id":13384,"translation":"« ⟦T000⟧ бежала рядом со мной."},{"id":13385,"translation":"« «Я бегу так быстро, как могу!»"},{"id":13386,"translation":"« Я не обратила на неё внимания."},{"id":13387,"translation":"«Грёбаный мудак?» — донеслось от ⟦T000⟧, и я рассмеялась."},{"id":13388,"translation":"«Я правда ничего не знаю»."},{"id":13389,"translation":"«Удачи»."},{"id":13390,"translation":"«Пока я не могу сказать больше, но знай: со своей стороны я сделаю всё, что смогу»."},{"id":13391,"translation":"« «Конечно, знаю!»"},{"id":13392,"translation":"« Я была рада, что она согласилась прийти."},{"id":13393,"translation":"«Что он сказал?» — спросила ⟦T000⟧, поравнявшись со мной."},{"id":13394,"translation":"«Мы найдём ⟦T000⟧ и его стаю»."},{"id":13395,"translation":"« «Зачем вы здесь?»"},{"id":13396,"translation":"«Волки ⟦T000⟧?»"},{"id":13397,"translation":"«Стая Wolf-father?»"},{"id":13398,"translation":"««Где они?»"},{"id":13399,"translation":"« «Что это значит?»"},{"id":13400,"translation":"« Наверное, она была права."},{"id":13401,"translation":"«Тут не над чем смеяться!»»"},{"id":13402,"translation":"«Где именно в лесу»."},{"id":13403,"translation":"« «Это было... занятно"},{"id":13404,"translation":"« «Здесь все духи такие?»"},{"id":13405,"translation":"«Они возглавляют Стаю?»"},{"id":13406,"translation":"«Нет»."},{"id":13407,"translation":"«Ты была здесь». Я повернулась к ⟦T000⟧, и в моём голосе прозвучало обвинение."},{"id":13408,"translation":"«⟦T000⟧ была здесь», — сказала я."},{"id":13409,"translation":"«Это связано с культом Фенриса?»"},{"id":13410,"translation":"« «Что это, чёрт возьми?»"},{"id":13411,"translation":"«Но зачем здесь был ⟦T000⟧?»"},{"id":13412,"translation":"« Разве снаружи не должно быть людей?"},{"id":13413,"translation":"«Что теперь?» — прошептала ⟦T000⟧."},{"id":13414,"translation":"«Так вы... не?..» — медленно спросил один из них."},{"id":13415,"translation":"«Нет, мы беженцы». Тут охранник схватил меня за руку."},{"id":13416,"translation":"«Ладно, веди»."},{"id":13417,"translation":"«Отойди»."},{"id":13418,"translation":"⟦T000⟧."},{"id":13419,"translation":"«Вы видели этого человека?»"},{"id":13420,"translation":"« «На это место кто-нибудь нападал?»"},{"id":13421,"translation":"«  «В последнее время здесь были какие-нибудь проблемы?»"},{"id":13422,"translation":"« «Кто-нибудь видел волков?»"},{"id":13423,"translation":"«Простите, мне пора»."},{"id":13424,"translation":"«Никто из них не вошёл?»"},{"id":13425,"translation":"«Почему мы здесь?»"},{"id":13426,"translation":"«Мы просто ищем убежище»."},{"id":13427,"translation":"«Ты его не вырубила?»"},{"id":13428,"translation":"«Идём»."},{"id":13429,"translation":"« Нужно было скорее убираться отсюда."},{"id":13430,"translation":"«Надо придумать, как попасть внутрь», — прошептала ⟦T000⟧."},{"id":13431,"translation":"«Так тоже сойдёт»."},{"id":13432,"translation":"«Что это, мать его, было??»"},{"id":13433,"translation":"Стой."},{"id":13434,"translation":"«Мы не те, кого вы ищете»."},{"id":13435,"translation":"« ⟦T000⟧ рывком распахнула дверь."},{"id":13436,"translation":"«Она не могла далеко уйти»."},{"id":13437,"translation":"« «Вот вы где!»"},{"id":13438,"translation":"«Нам надо уходить!»"},{"id":13439,"translation":"«Вот мы где? А вы-то где были??» — не поверила я."},{"id":13440,"translation":"« За кем мне идти?"},{"id":13441,"translation":"«А как же ⟦T000⟧?» — прорычала я."},{"id":13442,"translation":"«С ней всё будет хорошо. Она может за себя постоять», — ответил он."},{"id":13443,"translation":"« Сейчас нам нужно было убираться отсюда — и побыстрее."},{"id":13444,"translation":"«Что, чёрт возьми, происходит??»"},{"id":13445,"translation":"«Стая Wolf-father», — выругалась я. ⟦T000⟧ ⟦T001⟧согласно зарычала⟦T002⟧."},{"id":13446,"translation":"Спасибо."},{"id":13447,"translation":"«И ты выбралась без единой раны?»"},{"id":13448,"translation":"« Я промолчала."},{"id":13449,"translation":"« Я всмотрелась в их лица."},{"id":13450,"translation":" «Всё это кажется слишком уж неслучайным», — скептически сказала я."},{"id":13451,"translation":"«Ладно», — коротко ответила ⟦T000⟧."},{"id":13452,"translation":"«Но завтра нам всё равно придётся попросить кого-нибудь проводить нас», — наконец сказал он."},{"id":13453,"translation":" «Попросим ⟦T000⟧», — сказала я, и он согласно кивнул."},{"id":13454,"translation":" «Попросим ⟦T000⟧», — сказала я, и он согласно кивнул."},{"id":13455,"translation":"«Но нам всё равно придётся попросить кого-нибудь завтра проводить нас», — наконец сказал он."},{"id":13456,"translation":"«Почему бы тебе не вернуться со мной прямо сейчас?»"},{"id":13457,"translation":"«Я должна хотя бы попытаться их убедить»."},{"id":13458,"translation":"« «Уйди, мать твою, с дороги!»"},{"id":13459,"translation":"« «Что, чёрт возьми, происходит?»"},{"id":13460,"translation":"« «Кто это был?»"},{"id":13461,"translation":"« «Мне нужны ответы. ⟦T000⟧Сейчас⟦T001⟧»."},{"id":13462,"translation":" «И что мне делать?» — спросила я, не уверенная, что хочу услышать ответ."},{"id":13463,"translation":"«Прочь!»"},{"id":13464,"translation":"« Я метнулась в сторону."},{"id":13465,"translation":"«Нет», — выдохнула я, уже зная, что сейчас произойдёт."},{"id":13466,"translation":"Убийца."},{"id":13467,"translation":"«Это был несчастный случай», — мягко сказал Kazim."},{"id":13468,"translation":"«Это не твоя вина», — мягко сказал Kazim."},{"id":13469,"translation":"« Я видела, что ⟦T000⟧ напряжена."},{"id":13470,"translation":" «Кстати, как вы познакомились?» — спросила я. «Ты и ⟦T000⟧»."},{"id":13471,"translation":" «Прости», — наконец сказала я."},{"id":13472,"translation":" «Ты сегодня справишься?» — нерешительно спросила я."},{"id":13473,"translation":" «Ты сегодня справишься? Я о драке с ⟦T000⟧»."},{"id":13474,"translation":"«Даже если ради этого придётся его убить»."},{"id":13475,"translation":"«Как далеко ты готов зайти?»"},{"id":13476,"translation":"«Неужели всё так просто?»"},{"id":13477,"translation":"«  Скорость важнее безопасности."},{"id":13478,"translation":"« Я осталась одна."},{"id":13479,"translation":"« ⟦T000⟧«Удачи...»⟦T001⟧"},{"id":13480,"translation":"« Она за это умрёт!"},{"id":13481,"translation":"«Сюда», — прорычала ⟦T000⟧ и побежала вдоль сверкающей серебряной стены."},{"id":13482,"translation":"« Скорость важнее безопасности."},{"id":13483,"translation":"и "},{"id":13484,"translation":"«Здравствуй, ⟦T000⟧»."},{"id":13485,"translation":"«Просто поверь мне», — быстро сказала ⟦T000⟧ и повернулась к ⟦T001⟧."},{"id":13486,"translation":"« Мы должны были сражаться!"},{"id":13487,"translation":"« Во мне вскипела ярость."},{"id":13488,"translation":"« Мы должны были их спасти!"},{"id":13489,"translation":"« Мы должны были выиграть для них время!"},{"id":13490,"translation":"« Я на мгновение отвлеклась."},{"id":13491,"translation":"«Мне нужно, чтобы ты кое-что сделала»."},{"id":13492,"translation":"« Нужно было остановить их — немедленно!"},{"id":13493,"translation":"« Им не уйти!"},{"id":13494,"translation":"« Меня охватила паника."},{"id":13495,"translation":"« Им не сбежать!"},{"id":13496,"translation":"«Тогда тебе следовало понимать, чем обернётся нападение!»"},{"id":13497,"translation":"«Боюсь, мы друг друга не понимаем»."},{"id":13498,"translation":"« Нам нужно было уходить."},{"id":13499,"translation":"« Я извернулась, уходя от удара."},{"id":13500,"translation":"« Ей не сбежать!"},{"id":13501,"translation":" стаи. "},{"id":13502,"translation":"« Меня грызло чувство вины."},{"id":13503,"translation":"« Мы сделали это."},{"id":13504,"translation":"« Мне уже было всё равно."},{"id":13505,"translation":"« Больше ничто не имело значения."},{"id":13506,"translation":"« Это не имело значения."}]}