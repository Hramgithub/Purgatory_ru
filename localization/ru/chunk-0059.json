{"chunk":59,"items":[{"id":13129,"translation":"\" Я взяла себя в руки."},{"id":13130,"translation":"\"Я ухожу на сегодня. Я заболела.\""},{"id":13131,"translation":"\" Нужно было попробовать что-нибудь другое."},{"id":13132,"translation":"\" ⟦T000⟧Наверное, ничего особенного.⟦T001⟧"},{"id":13133,"translation":"Исцелить."},{"id":13134,"translation":"\"Прекрати сейчас же!\""},{"id":13135,"translation":"Эпифлинги."},{"id":13136,"translation":"Элементали."},{"id":13137,"translation":"\" ⟦T000⟧Чёрт, теперь я поняла, где мы.⟦T001⟧"},{"id":13138,"translation":"\"Это враг.\""},{"id":13139,"translation":" \"Это враг\", — с горечью сказала я."},{"id":13140,"translation":" \"Где ⟦T000⟧?\" — спросила я, оглядываясь."},{"id":13141,"translation":"\" Внезапно ⟦T000⟧ бросился к змее."},{"id":13142,"translation":" \"Блядь\", — прорычал ⟦T000⟧. \"Придётся разобраться с этим позже.\""},{"id":13143,"translation":" \"Разберёмся с этим позже\", — прорычал ⟦T000⟧."},{"id":13144,"translation":"\"Неважно\", — сказал ⟦T000⟧, хмуро глядя на компьютер."},{"id":13145,"translation":"\"Откуда ты знаешь?\""},{"id":13146,"translation":" \"Ни за что\", — твёрдо сказала я."},{"id":13147,"translation":"Ладно."},{"id":13148,"translation":"\"От ⟦T000⟧?\" — спросила я."},{"id":13149,"translation":"\" Нужна была стратегия."},{"id":13150,"translation":"\" Я не могла пошевелиться."},{"id":13151,"translation":"\" Я ⟦T000⟧бросилась⟦T001⟧ на женщину."},{"id":13152,"translation":"\"Что вы с ним сделали.\" — обманчиво спокойным голосом произнёс ⟦T000⟧."},{"id":13153,"translation":"\"Но ты знаешь, кто это был?\" — предположила я."},{"id":13154,"translation":"\"Говори\", — прорычала я."},{"id":13155,"translation":"\"Потому что мы убьём вас обоих.\" Голос мой звучал мрачно и бесстрастно."},{"id":13156,"translation":"\"Почему бы не рассказать нам?\" — спросила я. \"Вы ведь явно и так собираетесь нас убить.\""},{"id":13157,"translation":"\" Я должна была помочь!"},{"id":13158,"translation":"\"\" @story:rage=+5:harano=+1 Я должна была помочь!"},{"id":13159,"translation":"\" Я полоснула тварь когтями."},{"id":13160,"translation":"\" Она набросилась на Зелёную Сирену."},{"id":13161,"translation":"\" ⟦T000⟧ помог мне исцелиться."},{"id":13162,"translation":"\"Ей также было интересно узнать о причастности ⟦T000⟧.\""},{"id":13163,"translation":"\"Не могу сказать, что знаю.\""},{"id":13164,"translation":" \"Меня как раз риски и беспокоят!\" "},{"id":13165,"translation":" \"Другого пути нет?\" — спросила я. "},{"id":13166,"translation":"\"Серьёзно?\""},{"id":13167,"translation":"\"Тогда почему нельзя принять всех?\""},{"id":13168,"translation":"\"И что тогда будешь делать ты?\" — настороженно спросила я."},{"id":13169,"translation":"\"Я буду наблюдать. Просто заставь его открыть ворота, а дальше я сам.\""},{"id":13170,"translation":"\"Ага...\" Я решила, что лучше просто смириться с его загадочностью."},{"id":13171,"translation":"\"Эй! Открывайте!\""},{"id":13172,"translation":"\"Что, мне и выйти нельзя?\""},{"id":13173,"translation":" \"Что, мне и выйти нельзя?\" — прорычала я."},{"id":13174,"translation":"\"Знаешь, наружу можно выйти и попроще.\""},{"id":13175,"translation":"\"Что это было?!\""},{"id":13176,"translation":"\"Он...мёртв?\""},{"id":13177,"translation":" \"Эм, что это, мать его, было?!\" "},{"id":13178,"translation":"\"Полезем на второй этаж\", — решительно сказала я."},{"id":13179,"translation":"\" Я подавила ⟦T000⟧раздражение.⟦T001⟧"},{"id":13180,"translation":" \"Ладно, идём\", — коротко сказала я, слегка задетая."},{"id":13181,"translation":"\" ⟦T000⟧ выглядел ⟦T001⟧задумчивым⟦T002⟧."},{"id":13182,"translation":"\"И что ты предлагаешь?\" — спросил он, приподняв брови."},{"id":13183,"translation":"\"Надо вызвать полицию!\""},{"id":13184,"translation":"\"Какая разница?\""},{"id":13185,"translation":"\"Думаешь, мы выберемся отсюда незамеченными?\""},{"id":13186,"translation":"\"Они решат, что это кто-то из их Гару.\""},{"id":13187,"translation":"\" В его глазах появилась боль."},{"id":13188,"translation":"\"Нет!\" — взревела в ответ толпа, охваченная ураганом гнева."},{"id":13189,"translation":"\"Как мы поймём, которая из них его?\""},{"id":13190,"translation":" \"Но как мы поймём, которая из них его?\""},{"id":13191,"translation":"\" Я вспомнила слухи."},{"id":13192,"translation":" \"Это потому, что вы встречались?\""},{"id":13193,"translation":"\" Я вдруг вспомнила, что читала о них."},{"id":13194,"translation":"\" Они были не так просты, как казались."},{"id":13195,"translation":"\"Тарпаны — это ⟦T000⟧духи-отголоски⟦T001⟧\", — тихо объяснил ⟦T002⟧."},{"id":13196,"translation":"\"И что нам с ними делать?\" — пробормотала я."},{"id":13197,"translation":"Уйти."},{"id":13198,"translation":"\"Ты знаешь, что это?\""},{"id":13199,"translation":"\"Он раньше интересовался чем-нибудь подобным?\""},{"id":13200,"translation":"\" ⟦T000⟧ сердито посмотрела на меня."},{"id":13201,"translation":"\"Почему нет?\""},{"id":13202,"translation":"\" Я позвала ⟦T000⟧."},{"id":13203,"translation":"\"Можно спросить, что между вами произошло?\""},{"id":13204,"translation":"\"Ой!\" — смущённо произнесла я. \"Прости.\""},{"id":13205,"translation":"\"Всё нормально.\""},{"id":13206,"translation":"\"Не знаю. Я видела это ещё в прошлый раз, но внутрь не заходила.\""},{"id":13207,"translation":"\"Откуда ты знала, что это там?\" — удивилась я."},{"id":13208,"translation":"\"Они всегда у него были?\""},{"id":13209,"translation":"\" Я набила стволы оружия землёй."},{"id":13210,"translation":"Ахрун."},{"id":13211,"translation":"Гару."},{"id":13212,"translation":"\" Я спросила снова."},{"id":13213,"translation":" \"Что ты можешь рассказать нам о ⟦T000⟧?\" — спросила я."},{"id":13214,"translation":"\" Она разозлилась ещё сильнее."},{"id":13215,"translation":"\"Не глупи, ⟦T000⟧. Никому этого не хочется.\""},{"id":13216,"translation":"\"⟦T000⟧ хочется\", — мрачно сказала я."},{"id":13217,"translation":"\"Эй, полегче!\" — сказала я, останавливаясь. \"Куда так спешить?\""},{"id":13218,"translation":"\"Отлично! Тогда мне пора. До отъезда нужно ещё многое спланировать.\""},{"id":13219,"translation":" \"Прости, я просто...не могу.\" "},{"id":13220,"translation":"\"Прости, ⟦T000⟧, но это слишком рискованно.\""},{"id":13221,"translation":"\"К сожалению, ему это удалось.\""},{"id":13222,"translation":"\"К счастью, ему это не удалось.\""},{"id":13223,"translation":"\"Таким образом, я голосую за ⟦T000⟧изгнание⟦T001⟧ ⟦T002⟧ из варшавского септа.\""},{"id":13224,"translation":"\"Все, кто за изгнание ⟦T000⟧, поднимите руки.\""},{"id":13225,"translation":"\"Таким образом, я голосую за ⟦T000⟧изгнание⟦T001⟧ ⟦T002⟧ из варшавского ⟦T003⟧септа⟦T004⟧.\""},{"id":13226,"translation":"\" Мы проиграли."},{"id":13227,"translation":"\"С ⟦T000⟧ что-то случилось?\""},{"id":13228,"translation":"\"Ты всё ещё в Стае?\""},{"id":13229,"translation":"\"Ты поговорила с ⟦T000⟧?\""},{"id":13230,"translation":"\"Чёрт, ⟦T000⟧...\" Я не знала, что сказать, но она лишь отмахнулась."},{"id":13231,"translation":"\"Неважно. Я знала, на что шла, когда это сказала.\""},{"id":13232,"translation":"\"Кроме того, что он выгнал меня из Стаи?\""},{"id":13233,"translation":"\"Я знаю лишь, что это как-то связано с ⟦T000⟧беженцами⟦T001⟧.\""},{"id":13234,"translation":"\"Ведь дело не в этом?\""},{"id":13235,"translation":"\"Стой!\" — крикнула я, но он меня проигнорировал."},{"id":13236,"translation":" \"Я сказала: пропусти нас.\" "},{"id":13237,"translation":" \"Я заплачу\", — в отчаянии сказала я. "},{"id":13238,"translation":" \"Нам обещали свободный проход\", — начала я, но он меня перебил. "},{"id":13239,"translation":"\"Да-да, вам всем обещали. Неважно, вас не пропустят.\""},{"id":13240,"translation":"\"Да.\""},{"id":13241,"translation":"\"Ничего.\""},{"id":13242,"translation":"\"Я за него волнуюсь.\""},{"id":13243,"translation":"\"Я боюсь снова с ним встретиться.\""},{"id":13244,"translation":"\"Мой хозяин вами недоволен.\""},{"id":13245,"translation":" \"Мой хозяин узнал о вас двоих от того неудачника.\""},{"id":13246,"translation":"\" Я должна была ей помочь!"},{"id":13247,"translation":"\"Итак, ⟦T000⟧Беловежская пуща⟦T001⟧. Вы там бывали?\""},{"id":13248,"translation":"\"Вообще-то мне нужно тебе кое-что сказать...\""},{"id":13249,"translation":"\"Чёрт возьми\", — пробормотал его напарник."},{"id":13250,"translation":" \"Я не могу\", — сказала я, качая головой."},{"id":13251,"translation":" \"Я это сделаю\", — мрачно ответила я."},{"id":13252,"translation":" \"Как хочешь\", — ответила я."},{"id":13253,"translation":" \"И давно ты с ними?\" — недоверчиво спросила я."},{"id":13254,"translation":" \"Значит, ради собственного спасения ты готов убивать других\", — язвительно сказала я."},{"id":13255,"translation":"\"Вот именно — ой. И полагаю, Krzysztof тоже убил ты?\""},{"id":13256,"translation":"\"Он мёртв.\""},{"id":13257,"translation":"\"Не совсем.\""},{"id":13258,"translation":"\"Я в порядке\", — ответил он, хотя я заметила, что лицо у него было мертвенно-⟦T000⟧бледным⟦T001⟧."},{"id":13259,"translation":"\"Krzysztof мёртв\", — коротко добавил он. \"А другая?\""},{"id":13260,"translation":"\"Что насчёт неё?\" — неловко произнесла я, указывая на Noor."},{"id":13261,"translation":"\"Нет!\""},{"id":13262,"translation":"\"Какого хрена, ⟦T000⟧?!\" — заорала я."},{"id":13263,"translation":"В основном."},{"id":13264,"translation":"\"Итак, о чём ты хотела узнать?\" — спросила она."},{"id":13265,"translation":"\"Вы бывали на границе?\""},{"id":13266,"translation":"\"Почему вы решили приехать сюда?\""},{"id":13267,"translation":"\"Вы бывали в лесу?\""},{"id":13268,"translation":"\"Это полный кошмар.\""},{"id":13269,"translation":"\"Разве это не противозаконно?\""},{"id":13270,"translation":"\"Насколько строго они за этим следят?\""},{"id":13271,"translation":"\"Например?\""},{"id":13272,"translation":"\"Как вы об этом узнали?\""},{"id":13273,"translation":"\"Почему странная?\""},{"id":13274,"translation":" \"Вы бывали в лесу?\" — спросила я."},{"id":13275,"translation":"\"А если я поделюсь с вами всем, что найду?\""},{"id":13276,"translation":" \"А если мы вам поможем?\" — быстро предложил ⟦T000⟧."},{"id":13277,"translation":"\"Вы знаете, кто такой генерал ⟦T000⟧?\""},{"id":13278,"translation":"\"Не сегодня. Может, завтра — не знаю, но ⟦T000⟧скоро⟦T001⟧.\""},{"id":13279,"translation":"\"Я?\""},{"id":13280,"translation":" \"Вы здесь живёте?\" — с любопытством спросила я."},{"id":13281,"translation":" \"Вы хороший человек\", — горячо сказала я."},{"id":13282,"translation":" \"И что они на это говорят?\" — удивилась я."},{"id":13283,"translation":"\"Он лжёт.\""},{"id":13284,"translation":"\"Его изгнали!\""},{"id":13285,"translation":"\"Мы думаем, он связан с Культом Фенрира.\""},{"id":13286,"translation":"\"К чему ты клонишь?\""},{"id":13287,"translation":"\"Это тревожно.\""},{"id":13288,"translation":"\"⟦T000⟧ не производил такого впечатления.\""},{"id":13289,"translation":" \"Мы думаем, он связан с Культом Фенрира.\" "},{"id":13290,"translation":"\"Какая проблема?\""},{"id":13291,"translation":"\"Вы не собираетесь помогать??\""},{"id":13292,"translation":"\"И Гару в это верят?\""},{"id":13293,"translation":" \"Он лжёт\", — безучастно сказала я."},{"id":13294,"translation":"\"Спасибо, ⟦T000⟧\", — с благодарностью сказала я."},{"id":13295,"translation":"\"Я в порядке.\""},{"id":13296,"translation":" \"Я в порядке\", — сказала я, втайне радуясь её беспокойству. "},{"id":13297,"translation":"Враждебность."},{"id":13298,"translation":"Настороженность."},{"id":13299,"translation":"Беспокойство."},{"id":13300,"translation":"\"Зачем мне лгать?\""},{"id":13301,"translation":" \"⟦T000⟧Моя семья⟦T001⟧\", — наконец сказала я. "},{"id":13302,"translation":"\"Ты пыталась меня убить\", — ⟦T000⟧прошептало⟦T001⟧ оно."},{"id":13303,"translation":"\"Ты не виновата\", — прошептало оно."},{"id":13304,"translation":"\"Нет, виновата.\""},{"id":13305,"translation":"\"Я должна была что-нибудь сделать.\""},{"id":13306,"translation":"\"Ты тоже не виновато!\""},{"id":13307,"translation":"\"Afghan Pesarak\" — Aryana Sayeed."},{"id":13308,"translation":"\"Awaleen Ishqam\" — Ahmad Zahir."},{"id":13309,"translation":"\"I Ciebie też, bardzo\" — Męskie Granie Orkiestra."},{"id":13310,"translation":"\"Santa Fe\" — Beirut."},{"id":13311,"translation":"\"Эй...\" Я тут же умолкла, услышав в трубке встревоженный голос ⟦T000⟧."},{"id":13312,"translation":"\"⟦T000⟧, ⟦T001⟧⟦T002⟧ только что позвонил⟦T003⟧.\""},{"id":13313,"translation":"\" \"Как он??\""},{"id":13314,"translation":"\" \"Почему он не позвонил мне?\""},{"id":13315,"translation":"\"Наверное, у него не было твоего номера.\""},{"id":13316,"translation":"\"Это неважно.\""},{"id":13317,"translation":"\"Когда?\" — лихорадочно спросила я."},{"id":13318,"translation":"\"Точного времени он не знал, но сказал, что точно не сегодня.\""},{"id":13319,"translation":"\"Понятно.\""},{"id":13320,"translation":"\"Жаль.\""},{"id":13321,"translation":"\"Привет, извини, я звоню насчёт ⟦T000⟧.\""},{"id":13322,"translation":"\" В его голосе слышалось облегчение."},{"id":13323,"translation":"\"Я помогу тебе перейти.\""},{"id":13324,"translation":"\"Почему ты не позвонила раньше?\""},{"id":13325,"translation":"\"Поверь мне\", — твёрдо сказала я."},{"id":13326,"translation":"\"А как же твои поездки?\""},{"id":13327,"translation":"\"Я сильнее тебя!\""},{"id":13328,"translation":"\"Я могу за себя постоять!\""},{"id":13329,"translation":" \"⟦T000⟧, без обид, но я сильнее тебя. Я могу тебя защитить.\""},{"id":13330,"translation":"\"Знаю, знаю. Дело было не в этом. Я волновался за тебя, ⟦T000⟧.\""},{"id":13331,"translation":"\"Ох.\""},{"id":13332,"translation":"\"Послушай, я это ценю, — продолжила я, — но ты должен мне доверять.\""},{"id":13333,"translation":"\"Да послушай же.\""},{"id":13334,"translation":"\"За меня не нужно волноваться.\""},{"id":13335,"translation":"\"Тогда мне точно нужно приехать прямо сейчас!\""},{"id":13336,"translation":"\"Когда?\""},{"id":13337,"translation":"\"Здесь тоже что-то происходит.\""},{"id":13338,"translation":"Облегчение."},{"id":13339,"translation":"Тревога."},{"id":13340,"translation":"Ужас."},{"id":13341,"translation":"\"Что он сказал?\" — спросил подошедший ко мне ⟦T000⟧."},{"id":13342,"translation":"\"Да они не такие уж плохие\", — пожал плечами ⟦T000⟧."},{"id":13343,"translation":"\"Формально это всё ещё утро!\" — со смехом возразил ⟦T000⟧."},{"id":13344,"translation":"\"Погоди, ты идёшь с нами?\" — удивилась я."},{"id":13345,"translation":"\"Добро пожаловать, дети ⟦T000⟧Гайи⟦T001⟧.\""},{"id":13346,"translation":"\"Зачем вы здесь?\""},{"id":13347,"translation":"\"Оружие?\""},{"id":13348,"translation":"\"Это было...интересно.\""},{"id":13349,"translation":"\"Здесь все духи такие?\""},{"id":13350,"translation":"Кровь."},{"id":13351,"translation":"Бензин."},{"id":13352,"translation":"\" У нас не было времени останавливаться."},{"id":13353,"translation":"\" Мы пройдём через ограду."},{"id":13354,"translation":"\" Мы с ⟦T000⟧ подготовились к этому ещё вчера вечером."},{"id":13355,"translation":"\"Это дискриминация, Szeregowy Nowak.\""},{"id":13356,"translation":"\"Нам нужно обыскать одно из этих зданий\", — тихо сказал ⟦T000⟧."},{"id":13357,"translation":" снаружи."},{"id":13358,"translation":"\"Все мысли вылетели у меня из головы."},{"id":13359,"translation":"\" \"Есть ещё кое-что.\""},{"id":13360,"translation":"\"Что теперь?\" — пробормотал ⟦T000⟧."},{"id":13361,"translation":" \"Резонно\", — признала я. \"Тогда поищем в другом месте.\""},{"id":13362,"translation":"\" Я почувствовала, как во мне нарастает Ярость."},{"id":13363,"translation":"\" Я усмирила свою Ярость."},{"id":13364,"translation":"\" \"Они бегут к лесу!\""},{"id":13365,"translation":"Хрясь!"},{"id":13366,"translation":"\"Поговорим с генералом ⟦T000⟧.\""},{"id":13367,"translation":"\"Поговорим с ⟦T000⟧.\""},{"id":13368,"translation":"\"Хорошо, так и сделаем\", — согласился ⟦T000⟧."}]}