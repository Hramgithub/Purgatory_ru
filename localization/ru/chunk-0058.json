{"chunk":58,"items":[{"id":12889,"translation":"Бармен"},{"id":12890,"translation":"Вербена"},{"id":12891,"translation":"Улика"},{"id":12892,"translation":"Формор"},{"id":12893,"translation":"Страх"},{"id":12894,"translation":"Наёмные громилы"},{"id":12895,"translation":"Красные глаза"},{"id":12896,"translation":"Источник"},{"id":12897,"translation":"Смертельная плата"},{"id":12898,"translation":"Доказательство"},{"id":12899,"translation":"Арсенал"},{"id":12900,"translation":"Провидец"},{"id":12901,"translation":"Скрытый враг"},{"id":12902,"translation":"Хозяин Бэйна"},{"id":12903,"translation":"Драка в поезде"},{"id":12904,"translation":"Серые массы"},{"id":12905,"translation":"Серая масса"},{"id":12906,"translation":"Наводка"},{"id":12907,"translation":"Обман"},{"id":12908,"translation":"В ловушке"},{"id":12909,"translation":"Ложь ⟦T000⟧"},{"id":12910,"translation":"Переправа"},{"id":12911,"translation":"Болота"},{"id":12912,"translation":"УЛИКА"},{"id":12913,"translation":"Отношения"},{"id":12914,"translation":"Каэрн"},{"id":12915,"translation":"Семья"},{"id":12916,"translation":"Пуща"},{"id":12917,"translation":"Полиция"},{"id":12918,"translation":"Пресса"},{"id":12919,"translation":"⟦T000⟧Журналист⟦T001⟧"},{"id":12920,"translation":">>> ui \"character-name=⟦T000⟧\" snapshot=werewolf notifications-pause"},{"id":12921,"translation":"⟦T000⟧Ахрун⟦T001⟧"},{"id":12922,"translation":"⟦T000⟧Галлиард⟦T001⟧"},{"id":12923,"translation":"⟦T000⟧Филодокс⟦T001⟧"},{"id":12924,"translation":"⟦T000⟧Теург⟦T001⟧"},{"id":12925,"translation":"⟦T000⟧Рагабаш⟦T001⟧"},{"id":12926,"translation":" ноль"},{"id":12927,"translation":"⟦T000⟧Клиат⟦T001⟧"},{"id":12928,"translation":"@inventory Я сменила облик."},{"id":12929,"translation":"@inventory:willpower=-1 Я сменила облик."},{"id":12930,"translation":"«Стоять!»"},{"id":12931,"translation":"«Не двигаться!»"},{"id":12932,"translation":"«Отвали!»"},{"id":12933,"translation":"«Я и сама справлялась»."},{"id":12934,"translation":"«Спасибо за помощь»."},{"id":12935,"translation":"«Отвали!» — прорычала я, отшатнувшись от неё."},{"id":12936,"translation":"«Спасибо за помощь», — с благодарностью сказала я."},{"id":12937,"translation":" \"Выберите ⟦T000⟧один⟦T001⟧ физический навык. Применять навыки рискованно, но это может окупиться.\""},{"id":12938,"translation":" \"Способность к физическим действиям: бегу, прыжкам и лазанию."},{"id":12939,"translation":" \"Выберите ⟦T000⟧один⟦T001⟧ социальный навык.\""},{"id":12940,"translation":" \"Выберите ⟦T000⟧один⟦T001⟧ ментальный навык.\""},{"id":12941,"translation":" \"Ну… Я предпочитаю сначала думать, а потом действовать."},{"id":12942,"translation":" \"В бой! +"},{"id":12943,"translation":"Ладно..."},{"id":12944,"translation":" «Наверное», — без энтузиазма ответила я. "},{"id":12945,"translation":" «С каких пор тебя волнует, что приемлемо?» — огрызнулась я. "},{"id":12946,"translation":" «Прости», — извинилась я."},{"id":12947,"translation":" «Наверное», — неохотно сказала я. "},{"id":12948,"translation":"«Наверное», — неохотно сказала я. "},{"id":12949,"translation":"Взлом."},{"id":12950,"translation":"«И что это должно значить?»"},{"id":12951,"translation":"«Я была... занята», — неловко ответила я."},{"id":12952,"translation":" «Всё в порядке?» — осторожно спросила я."},{"id":12953,"translation":"«Прости», — неловко сказала я."},{"id":12954,"translation":"Компьютеры."},{"id":12955,"translation":"Лидерство."},{"id":12956,"translation":"Благородство."},{"id":12957,"translation":"Доминирование."},{"id":12958,"translation":"Хитрость."},{"id":12959,"translation":"«Что там?» — спросила я."},{"id":12960,"translation":" «Зачем ⟦T000⟧ понадобилось ⟦T001⟧это⟦T002⟧?» — в ужасе спросила я. "},{"id":12961,"translation":" «Что это такое?!» — воскликнула я. "},{"id":12962,"translation":"«Где это произошло?»"},{"id":12963,"translation":" «На нём что-то есть...»"},{"id":12964,"translation":"«Ничего», — ответила я, но чувствовала: она знает, что я лгу."},{"id":12965,"translation":"Да."},{"id":12966,"translation":" «Какие обвинения?» — с любопытством спросила я."},{"id":12967,"translation":"«Как думаешь, в чём причина?» — с любопытством спросила я."},{"id":12968,"translation":"Оружие."},{"id":12969,"translation":"Броня."},{"id":12970,"translation":"«А, ⟦T000⟧. Наш ⟦T001⟧собственный⟦T002⟧ беженец»."},{"id":12971,"translation":"Крысы."},{"id":12972,"translation":"Ничего."},{"id":12973,"translation":"«Я, э-э, кажется, одного избила. Но с ним всё нормально. Наверное»."},{"id":12974,"translation":"Нет."},{"id":12975,"translation":" «Э-э, может быть…» — неловко сказала я, пока она потирала виски. "},{"id":12976,"translation":" «Мне разве не пора за работу?» — отрезала я. "},{"id":12977,"translation":" «А если я не хочу помогать?» — устало сказала я. "},{"id":12978,"translation":" «И как помочь?» — осторожно спросила я."},{"id":12979,"translation":" «Вообще-то сегодня я его видела», — коротко сказала я."},{"id":12980,"translation":" «Чем я могу помочь?» — с любопытством спросила я."},{"id":12981,"translation":" «Сегодня народу ещё больше, чем обычно», — заметила я."},{"id":12982,"translation":" «Думаешь, это ⟦T000⟧Ткач⟦T001⟧?» — спросила я, когда она замялась. "},{"id":12983,"translation":" «Как думаешь, в чём причина?» — спросила я. "},{"id":12984,"translation":"«Это из-за нас, да? Из-за беженцев»."},{"id":12985,"translation":"«Думаешь, это из-за беженцев»."},{"id":12986,"translation":" «Это у тебя уже четвёртое пиво?» — спросила я, пытаясь разрядить обстановку. "},{"id":12987,"translation":"«Прости, ⟦T000⟧, мне пора за работу», — рассеянно сказала я."},{"id":12988,"translation":"«Возможно. Я подумаю»."},{"id":12989,"translation":"Конечно."},{"id":12990,"translation":"«Ясно», — монотонно произнесла я, и ⟦T000⟧ стало не по себе."},{"id":12991,"translation":"«Я и правда всё испортила, да?»"},{"id":12992,"translation":"Дерьмо."},{"id":12993,"translation":"«Ты о чём?» — невинно спросила я, но ⟦T000⟧ не дал мне договорить."},{"id":12994,"translation":" «Дерьмо»."},{"id":12995,"translation":"«Ладно»."},{"id":12996,"translation":"«Моя смена закончилась. Можно я просто уйду?»"},{"id":12997,"translation":" «Он меня схватил», — коротко сказала я."},{"id":12998,"translation":"Дом."},{"id":12999,"translation":"Безопасность."},{"id":13000,"translation":"Сила."},{"id":13001,"translation":"Семья."},{"id":13002,"translation":" «Неважно», — коротко ответила я."},{"id":13003,"translation":"«На меня много всего навалилось», — пробормотала я, и ⟦T000⟧ нахмурился ещё сильнее."},{"id":13004,"translation":"«Это не ответ»."},{"id":13005,"translation":"«От ⟦T000⟧, вчера в ⟦T001⟧каэрне⟦T002⟧», — объяснила я."},{"id":13006,"translation":"«Но они были замешаны?» Я"},{"id":13007,"translation":"«Что именно?» — с любопытством спросила я."},{"id":13008,"translation":"«Почему ты попросил меня сегодня помочь?» — уточнила я."},{"id":13009,"translation":"«Мы на месте», — внезапно сказал ⟦T000⟧, когда мы вышли на широкую заснеженную поляну."},{"id":13010,"translation":"«Да, надо было», — сердито ответила я."},{"id":13011,"translation":" «Да ладно, всё нормально». Она снова начала извиняться, но я её перебила."},{"id":13012,"translation":"«Мне так жаль, ⟦T000⟧», — сочувственно сказала я."},{"id":13013,"translation":"«Так кто же тогда его нашёл?» — спросила я."},{"id":13014,"translation":" «Как думаешь, сколько он здесь пролежал?»"},{"id":13015,"translation":" «Люди ничего не заметили?»"},{"id":13016,"translation":" «Ты заметила что-нибудь, когда нашла его?»"},{"id":13017,"translation":" «Несколько дней назад?? С тех пор шёл снег. Почему ты не вернулась раньше??» "},{"id":13018,"translation":"«А». Я почувствовала себя глупо. «Прости». Она лишь раздражённо фыркнула."},{"id":13019,"translation":"«Когда вы вернулись, то что-нибудь нашли?» — нерешительно спросила я."},{"id":13020,"translation":"«Зачем мы снова здесь, если вы уже всё осмотрели?» — спросила я."},{"id":13021,"translation":"«К тому же ты можешь заметить что-то особенное...»"},{"id":13022,"translation":"«Спасибо, ⟦T000⟧», — сказала она, смягчившись. «Для меня это очень важно»."},{"id":13023,"translation":" «Всё нормально», — солгала я. ⟦T000⟧Лучше поскорее с этим покончить...⟦T001⟧"},{"id":13024,"translation":" «Всё нормально», — улыбнулась я ей, и она расслабилась. "},{"id":13025,"translation":"« Я осмотрела остальные фотографии."},{"id":13026,"translation":"« В этом ⟦T000⟧Бэйне⟦T001⟧ было что-то странное..."},{"id":13027,"translation":" «Можно поискать в снегу?» — предложила я. "},{"id":13028,"translation":" «И что ты предлагаешь?» — настороженно спросила я."},{"id":13029,"translation":"« Я неохотно согласилась на её план."},{"id":13030,"translation":"«Я умею превращаться в кого-то другого»."},{"id":13031,"translation":" «Постойте! Я ещё ищу своего друга — ⟦T000⟧ Kowalczyk»."},{"id":13032,"translation":"«Вопросы? О чём?»"},{"id":13033,"translation":" «Я ищу своего друга — ⟦T000⟧ Kowalczyk»."},{"id":13034,"translation":" «Постойте, вы лично с ним говорили?»"},{"id":13035,"translation":" «Вы с ним говорили?» — спросила я."},{"id":13036,"translation":" «Постойте! Вы сказали, у него были вопросы к местным? Какие?»"},{"id":13037,"translation":" «Как вам удалось пересечь границу?» — с любопытством спросила я."},{"id":13038,"translation":"«⟦T000⟧? О, здесь его не очень-то любят»."},{"id":13039,"translation":" «Что вы имеете в виду?» — спросила я, заметив её неловкость."},{"id":13040,"translation":" «Что вы будете делать дальше?» — спросила я."},{"id":13041,"translation":"«Куда, блядь, направлялся ⟦T000⟧?» — спросил один из них."},{"id":13042,"translation":"«Куда, блядь, направлялся ⟦T000⟧?» — донёсся до меня голос одного из парней."},{"id":13043,"translation":"«Это грёбаный ⟦T000⟧формор⟦T001⟧», — выдохнула она."},{"id":13044,"translation":"«Что?» Я непонимающе уставилась на неё."},{"id":13045,"translation":" «Что стало с мальчиком? Он был в порядке?» — обеспокоенно спросила я."},{"id":13046,"translation":" «Это ⟦T000⟧формор⟦T001⟧ убил ⟦T002⟧?» — спросила я."},{"id":13047,"translation":"«Сегодня вечером я ещё покопаюсь», — продолжил ⟦T000⟧."},{"id":13048,"translation":"« Я заметила поблизости куст, за которым можно было укрыться."},{"id":13049,"translation":"«Стало опаснее», — пожаловался ⟦T000⟧."},{"id":13050,"translation":"«Нет. Если что-то и случилось, теперь уже поздно»."},{"id":13051,"translation":"« Я села наскоро позавтракать."},{"id":13052,"translation":"« Меня от этого ⟦T000⟧тошнило⟦T001⟧."},{"id":13053,"translation":"« Я отвела взгляд."},{"id":13054,"translation":"Пепел."},{"id":13055,"translation":"«Ладно."},{"id":13056,"translation":"«Так чем, по-твоему, это было?» — подтолкнула я его."},{"id":13057,"translation":"«Кажется, я догадываюсь, что это было»."},{"id":13058,"translation":" «Может, сядем внутри?» — спросила я, но ⟦T000⟧ решительно покачал головой. "},{"id":13059,"translation":"« Я решила не настаивать."},{"id":13060,"translation":"«Так мы можем зайти внутрь, пожалуйста?»"},{"id":13061,"translation":"«И сейчас ⟦T000⟧⟦T001⟧⟦T002⟧ не знает, кому она может ⟦T003⟧доверять⟦T004⟧»."},{"id":13062,"translation":"«Не могу сказать, что я с этим не согласна»."},{"id":13063,"translation":" «Не согласен?» — озадаченно спросила я. «Почему?» "},{"id":13064,"translation":" «Она тебе доверяет», — заметила я. "},{"id":13065,"translation":"«И что же нам теперь делать?» — спросила я"},{"id":13066,"translation":" «И ты думаешь, что она лжёт?» — спросила я. "},{"id":13067,"translation":"« Я не обращала на них внимания."},{"id":13068,"translation":"« Я уже смирилась."},{"id":13069,"translation":"« Это выглядело так безвкусно."},{"id":13070,"translation":"«То есть это могли упомянуть лишь для убедительности её лжи?»"},{"id":13071,"translation":" «Правда? Она говорила настолько подробно?» — скептически спросила я."},{"id":13072,"translation":"«По её словам, да. Чтобы „проучить их“. »"},{"id":13073,"translation":" «Вы упомянули, что ⟦T000⟧ был ранен?»"},{"id":13074,"translation":" «Вы упомянули, что ⟦T000⟧ был ранен?»"},{"id":13075,"translation":"«Тогда должны остаться следы крови».  Наши взгляды встретились."},{"id":13076,"translation":"«А их нет?»"},{"id":13077,"translation":"«Я услышала, что кто-то идёт. ⟦T000⟧Гару⟦T001⟧»."},{"id":13078,"translation":" «Эй, разве не здесь, по твоим словам, на тебя напали?»"},{"id":13079,"translation":"« Я продолжила ждать."},{"id":13080,"translation":"«Видимо, не даю тебе совершить какую-нибудь глупость», — раздражённо сказала я."},{"id":13081,"translation":"«О, глядите-ка, неужели это любимчик ⟦T000⟧?» — насмешливо бросил ему ⟦T001⟧."},{"id":13082,"translation":"«Если только ты не расскажешь, что здесь на самом деле происходит», — закончила я."},{"id":13083,"translation":" «Откуда ты это знаешь?» — раздражённо спросила я."},{"id":13084,"translation":"«Моё Харано», — обречённо сказала я, а она неловко кивнула."},{"id":13085,"translation":"«Да, оно»."},{"id":13086,"translation":" «Тогда зачем лгать о нападении?» — спросила я."},{"id":13087,"translation":"«⟦T000⟧ что?» — с любопытством спросила я."},{"id":13088,"translation":" «Так ты просто расист»."},{"id":13089,"translation":"« Я подбежала к ней рысцой."},{"id":13090,"translation":"« Я не обратила на это внимания."},{"id":13091,"translation":"Принять."},{"id":13092,"translation":"« Я взобралась на кирпичную стену."},{"id":13093,"translation":"Скоро."},{"id":13094,"translation":"«Ты потерпела неудачу», — пугающе будничным тоном произнесла фигура."},{"id":13095,"translation":"« Сегодня вечером я туда не пойду."},{"id":13096,"translation":"«Разве ты уже не проверял ноутбук ⟦T000⟧?»"},{"id":13097,"translation":"«Ладно, — прошептала ⟦T000⟧, — как будем проникать внутрь?»"},{"id":13098,"translation":"« ⟦T000⟧ отнёсся к этому скептически."},{"id":13099,"translation":"«Не волнуйся, мне нужно разобраться ещё с одним делом»."},{"id":13100,"translation":" «Постой, а почему мне тогда просто не пойти с тобой?» — озадаченно спросила я. "},{"id":13101,"translation":"« «Laura, где, чёрт возьми, твой отчёт?»"},{"id":13102,"translation":"« «Это ведь у тебя корги?»"},{"id":13103,"translation":"ИТ."},{"id":13104,"translation":"«Тебе всё ещё нужна помощь с компьютером?»"},{"id":13105,"translation":"«Как поживает ваш отдел?»"},{"id":13106,"translation":"«Ты говорила, что кто-то из твоих родных болен?»"},{"id":13107,"translation":"«Чёрт возьми, это и правда сработало», — покачав головой, сказала ⟦T000⟧."},{"id":13108,"translation":"« ⟦T000⟧Что это было за место?⟦T001⟧"},{"id":13109,"translation":"« Я ожидала совсем не этого."},{"id":13110,"translation":"« Я взглянула на него."},{"id":13111,"translation":"«Просто скажу, что пришла на собеседование», — сказала я."},{"id":13112,"translation":"«Тогда пойдёшь со мной?»"},{"id":13113,"translation":" «Всё будет хорошо», — уверенно сказала я."},{"id":13114,"translation":" «Maryam Ebrahimi»."},{"id":13115,"translation":"«Я пришла на собеседование, — непринуждённо солгала я, — в отдел ИТ, к Maja Kowalska»."},{"id":13116,"translation":"«Откройте ворота»."},{"id":13117,"translation":"« «Я здесь работаю»."},{"id":13118,"translation":"« «Я пришла на собеседование»."},{"id":13119,"translation":"« Я юркнула в соседнюю комнату."},{"id":13120,"translation":"«Замечательно», — с благодарностью в голосе сказала ⟦T000⟧.  "},{"id":13121,"translation":" «Каков твой план?» — прошептал ⟦T000⟧. "},{"id":13122,"translation":" «Что теперь?» — прошептал ⟦T000⟧. "},{"id":13123,"translation":"« «Как приятно снова с вами встретиться!»"},{"id":13124,"translation":"«Тебе лучше идти»."},{"id":13125,"translation":" «Тебе лучше сейчас уйти», — сказал ⟦T000⟧. "},{"id":13126,"translation":"«Скажу, что пришла на ⟦T000⟧собеседование»,⟦T001⟧ — сказала я."},{"id":13127,"translation":" «Нам лучше сейчас уйти», — сказал ⟦T000⟧. "},{"id":13128,"translation":"« Я ушла на встречу с ⟦T000⟧."}]}